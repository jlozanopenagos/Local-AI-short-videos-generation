# Environment Variables for Shorts Automation
# Copy this file to .env and adjust the values for your system:
# cp .env.example .env

# LLM API Configuration (OpenAI-compatible endpoint, e.g. LM Studio, Ollama, vLLM, or OpenAI)
LLM_API_KEY=your_api_key_here
LLM_API_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_NAME=Gemma-4-E2B

# ComfyUI Configuration
COMFY_API_URL=http://127.0.0.1:8188
# COMFY_DIR=C:/AI/ComfyUI_windows_portable
# COMFY_INPUT_DIR=C:/AI/ComfyUI_windows_portable/ComfyUI/input
# COMFY_OUTPUT_DIR=C:/AI/ComfyUI_windows_portable/ComfyUI/output
# OPEN_SWARA_DIR=C:/AI/ComfyUI_windows_portable/open-swara/voices

# Output Directory (Video renders, audio, and review CSVs)
# Can point to a secondary high-capacity drive (e.g. D:/AI/output) or local directory (./output)
OUTPUT_DIR=./output

# ==============================================================================
# Google Sheets Connectivity & Publishing Suite
# ==============================================================================
# The master Google Apps Script Web App URL for Option A dynamic routing (?id=<SPREADSHEET_ID>)
SHEETS_MASTER_WEBAPP_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEBAPP_ID/exec

# Individual Google Sheets URLs or spreadsheet IDs (optional overrides or direct links)
# English Endpoints
# SHEETS_ENDPOINT_ENGLISH_EXPRESSION=https://docs.google.com/spreadsheets/d/YOUR_ENGLISH_EXPRESSION_SHEET_ID/edit
