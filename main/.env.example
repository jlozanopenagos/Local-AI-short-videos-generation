# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
#
# ⚠️ WARNING: DO NOT PUT REAL SECRETS OR PRIVATE API KEYS IN THIS FILE!
# This template is tracked by Git and pushed to GitHub.
#
# How to safely configure your system:
# 1. Ensure you have a local '.env' file in this directory (main/.env).
# 2. Put your real API keys and private URLs only in 'main/.env'.
# 3. 'main/.env' is strictly listed in .gitignore and is NEVER pushed to GitHub.
# ==============================================================================

# LLM API Configuration (OpenAI-compatible endpoint, e.g. LM Studio, Ollama, vLLM, or OpenAI)
LLM_API_KEY=
LLM_API_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL_NAME=Gemma-4-E2B

# Google Gemini API Configuration (External Storyboard / Prompt Auditor)
# (Keep empty in this public template; set your real key only in main/.env or via the WebUI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ComfyUI Configuration (auto-detected relative to project root, or override below)
COMFY_API_URL=http://127.0.0.1:8188
# COMFY_DIR=../../ComfyUI_windows_portable
# COMFY_INPUT_DIR=../../ComfyUI_windows_portable/ComfyUI/input
# COMFY_OUTPUT_DIR=../../ComfyUI_windows_portable/ComfyUI/output
# OPEN_SWARA_DIR=../../ComfyUI_windows_portable/open-swara/voices

# Output Directory (Video renders, audio, and review CSVs)
# Can point to a custom local directory or relative path
OUTPUT_DIR=./output

# Voice Synthesis Engine & Quality Settings (Kokoro-82M & Qwen3-TTS ICL)
# Engine per language: 'kokoro' (built-in neural voices), 'qwen3' (ComfyUI reference cloning), or 'hybrid'
# VOICE_ENGINE_ENGLISH=qwen3
# VOICE_ENGINE_SPANISH=kokoro
# VOICE_ENGINE_FRENCH=hybrid
# VOICE_ENGINE_ITALIAN=kokoro
# KOKORO_SPEED_ENGLISH=0.92
# KOKORO_SPEED_SPANISH=0.90
# KOKORO_SPEED_FRENCH=0.90
# KOKORO_SPEED_ITALIAN=0.90
# QWEN3_USE_ICL=true
# QWEN3_LOCALIZE_INSTRUCT=true

# ==============================================================================
# Google Sheets Connectivity & Publishing Suite
# ==============================================================================
# The master Google Apps Script Web App URL for Option A dynamic routing (?id=<SPREADSHEET_ID>)
SHEETS_MASTER_WEBAPP_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_WEBAPP_ID/exec

# Individual Google Sheets URLs or spreadsheet IDs (optional overrides or direct links)
# English Endpoints
# SHEETS_ENDPOINT_ENGLISH_EXPRESSION=https://docs.google.com/spreadsheets/d/YOUR_ENGLISH_EXPRESSION_SHEET_ID/edit
# SHEETS_ENDPOINT_ENGLISH_GAME=https://docs.google.com/spreadsheets/d/YOUR_ENGLISH_GAME_SHEET_ID/edit
# SHEETS_ENDPOINT_ENGLISH_ROLEPLAY=https://docs.google.com/spreadsheets/d/YOUR_ENGLISH_ROLEPLAY_SHEET_ID/edit
# SHEETS_ENDPOINT_ENGLISH_FUN_FACTS=https://docs.google.com/spreadsheets/d/YOUR_ENGLISH_FUN_FACTS_SHEET_ID/edit

